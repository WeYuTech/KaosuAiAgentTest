# 僅填在後端，本檔不放真實金鑰。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_TEST_BUDGET_USD=20
MES_MODE=simulation
# 2026-10-30 只讀核對本環境 GETDATE 與 UTC 差為 +7 小時。
MES_SERVER_UTC_OFFSET_HOURS=7
AI_SECURE_COOKIE=0
# 若開發前端獨立於後端，填入明確的前端來源。
AI_ALLOWED_ORIGINS=http://127.0.0.1:5173

# 正式 MES 相關設定依 docs/MES整合.md，不在前端存放連線憑證。
